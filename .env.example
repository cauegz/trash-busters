# Chave criada em https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=cole-sua-chave-aqui

# Modelos Gemini usados para análise de imagens. O fallback é tentado somente
# se o modelo principal falhar.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Use um valor aleatório longo em ambientes compartilhados ou de produção.
API_SECURITY_TOKEN_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Os valores abaixo são opcionais. Os padrões permitem iniciar o projeto localmente.
# APP_PORT=8080
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=trashbusters_db
