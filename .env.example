# Chave do provedor de IA configurado no adaptador em infra/ai.
AI_PROVIDER_NAME=default
AI_API_KEY=cole-sua-chave-aqui

# Nome do modelo usado pelo provedor configurado.
# AI_MODEL=gemini-3.5-flash

# Use um valor aleatório longo em ambientes compartilhados ou de produção.
API_SECURITY_TOKEN_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Chave pública do CARTO Basemaps usada pelo frontend.
# Configure também como VITE_CARTO_API_KEY na Vercel.
# VITE_CARTO_API_KEY=

# Os valores abaixo são opcionais. Os padrões permitem iniciar o projeto localmente.
# APP_PORT=8080
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=trashbusters_db
